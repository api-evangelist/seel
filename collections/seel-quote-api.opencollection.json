      "type": "apikey",
      "key": "X-Seel-Api-Key",
      "value": "{{X-Seel-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote",
        "type": "folder"
      },
      "items": [
        {
          "info": {
