            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a quote"
        },
        {
          "info": {
            "name": "Get a quote",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-test.seel.com/v1/ecommerce/quotes/:quote_id",
            "params": [
              {
                "name": "quote_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a quote"
        }
      ]
    }
  ],
  "bundled": true
