{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seel Commerce Protection Bill Contract API",
    "version": "2.6.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Seel-Api-Key",
      "value": "{{X-Seel-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contract",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contracts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-test.seel.com/v1/ecommerce/contracts"
          },
          "docs": "List contracts"
        },
        {
          "info": {
            "name": "Get a contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-test.seel.com/v1/ecommerce/contracts/:contract_id",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a contract"
        }
      ]
    }
  ],
  "bundled": true
}