              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update an order"
        },
        {
          "info": {
            "name": "Cancel an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-test.seel.com/v1/ecommerce/orders/:order_id/cancel",
            "params": [
